# Secrets: the bot token. Never commit this; .env.example shows the format.
.env

# Extra private strings release.ps1 checks installers for (e.g. a work email)
private-strings.txt

# Data the bot creates while running
playlists.json
setup.log

# Rebuilt automatically
.venv/
__pycache__/

# Built installers: rebuild with build.ps1 (publish them as GitHub Releases rather than committing them)
dist/

# Editor settings (PyCharm)
.idea/

# Partial downloads yt-dlp can leave behind when a stream is stopped
*-Frag*
*.part
